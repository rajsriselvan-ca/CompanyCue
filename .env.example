# Required for live research. Supply your own API key.
GEMINI_API_KEY=

# Choose a model available to your API account.
GEMINI_MODEL=gemini-3.7-flash

# Optional fallback model.
GEMINI_FALLBACK_MODEL=gemini-3.7-flash

# Enable live search when supported by your API account.
GEMINI_GOOGLE_SEARCH_ENABLED=false

# Briefd retries temporary free-tier rate limits after 20s, then 40s.
GEMINI_QUOTA_MAX_RETRIES=2
GEMINI_QUOTA_RETRY_BASE_SECONDS=20

# SQLite is intentionally local; no external database is used.
DATABASE_URL=sqlite+aiosqlite:///./briefd.db

# JSON array or a comma-separated list.
CORS_ORIGINS=["http://localhost:3000"]
