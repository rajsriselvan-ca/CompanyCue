# CompanyCue configuration. Copy to .env and fill in your own keys.
# Never commit .env — it is gitignored.

# --- Required for live research ---------------------------------------------
# Groq (LLM): free key at https://console.groq.com/keys
GROQ_API_KEY=
# SerpAPI (Google Search): key at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# --- Models ------------------------------------------------------------------
# Writes the briefing sections. Needs to follow a JSON schema reliably.
GROQ_MODEL=openai/gpt-oss-120b
# Chooses the search queries. A small model is enough and keeps latency down.
GROQ_PLANNER_MODEL=openai/gpt-oss-20b

# --- Run without API keys -----------------------------------------------------
# Swaps both outbound HTTP transports for recorded fixtures. Every line of the
# client, prompt, tool-call and streaming code still runs — only the socket
# changes. Useful for a demo, or if a free-tier quota runs out mid-review.
MOCK_PROVIDERS=false

# --- Agent budget -------------------------------------------------------------
AGENT_MAX_TOOL_ROUNDS=5
AGENT_MAX_SEARCHES=8
AGENT_SECTION_CONCURRENCY=1

# --- Search tuning ------------------------------------------------------------
SERPAPI_RESULTS_PER_QUERY=6
SERPAPI_COUNTRY=us
SERPAPI_LANGUAGE=en

# --- Transport ----------------------------------------------------------------
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=90
HTTP_MAX_RETRIES=2
HTTP_RETRY_BASE_SECONDS=1

# --- SSE ----------------------------------------------------------------------
# Heartbeat comment interval; keeps proxies from dropping an idle stream.
SSE_HEARTBEAT_SECONDS=15
SSE_CLIENT_RETRY_MS=3000

# --- Local infrastructure -----------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./companycue.db
CORS_ORIGINS=["http://localhost:5173"]
